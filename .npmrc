# Install with yarn 1, as the Build workflow does: npx --yes yarn@1.22.22 install --frozen-lockfile.
# npm install would rewrite yarn.lock in a form yarn 1 can't read (it broke the Build workflow in
# 2.11.x) and add a package-lock.json; with this it leaves yarn.lock as it is and writes no lock.
package-lock=false
