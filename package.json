{
  "name": "floor3d-card",
  "version": "2.13.0",
  "description": "Your HA Digital Twin aka floor3d-card",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards"
  ],
  "module": "floor3d-card.js",
  "repository": "git+https://github.com/giosci1994/floor3d-card.git",
  "author": "Andrea Di Zanni <adizanni@msn.com>",
  "license": "MIT",
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "lit": "^3.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "home-assistant-js-websocket": "^9.7.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "rollup": "^4.63.5",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "scripts": {
    "start": "rollup -c rollup.config.dev.mjs --watch",
    "build": "rollup -c rollup.config.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"test/**/*.{mjs,json,html}\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"test/**/*.{mjs,json,html}\" \"*.mjs\"",
    "test": "node --experimental-strip-types --test test/config.test.mjs test/i18n.test.mjs test/maps.test.mjs test/slats.test.mjs test/sky.test.mjs test/boxes.test.mjs test/cameras.test.mjs test/ground.test.mjs test/rotate.test.mjs test/textmap.test.mjs",
    "test:browser": "node --test --test-concurrency=1 test/browser/run.mjs",
    "rollup": "rollup -c rollup.config.mjs"
  }
}
